{
  "name": "@payloadcms/vite",
  "version": "0.1.0",
  "description": "Payload CMS integration with Express + Vite (replaces @payloadcms/next)",
  "homepage": "https://payloadcms.com",
  "license": "MIT",
  "author": "Payload <dev@payloadcms.com> (https://payloadcms.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./admin/entry": {
      "import": "./src/admin/entry.tsx",
      "types": "./src/admin/entry.tsx",
      "default": "./src/admin/entry.tsx"
    },
    "./admin/router-adapter": {
      "import": "./src/admin/router-adapter.tsx",
      "types": "./src/admin/router-adapter.tsx",
      "default": "./src/admin/router-adapter.tsx"
    },
    "./vite-config": {
      "import": "./src/vite/config.ts",
      "types": "./src/vite/config.ts",
      "default": "./src/vite/config.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.0",
    "react-router-dom": "^7.6.1",
    "graphql-playground-html": "^1.6.30"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "5.7.3",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "payload": "workspace:*",
    "@payloadcms/ui": "workspace:*",
    "@payloadcms/graphql": "workspace:*",
    "@payloadcms/translations": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/graphql": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
